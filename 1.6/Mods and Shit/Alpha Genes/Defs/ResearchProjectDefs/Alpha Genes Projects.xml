      <li MayRequire="OskarPotocki.VFE.Medieval2">Ferny_DaneAxe</li>
      <li MayRequire="VanillaExpanded.VWE">Ferny_BattleAxe</li>
      <li>Ferny_Axe</li>
    </prerequisites>
  </ResearchProjectDef>

  <ResearchProjectDef MayRequire="sarg.alphagenes">
    <defName>Ferny_ForsakenBulkSword</defName>
    <label>forsaken bulk sword</label>
    <description>Craft compact alien sidearms made for rapid infantry close combat.</description>
    <baseCost>200</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Ferny_Arsenal</tab>
