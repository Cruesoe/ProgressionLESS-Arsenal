<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ResearchProjectDef MayRequire="sarg.alphagenes">
    <defName>Ferny_ForsakenBow</defName>
    <label>forsaken bow</label>
    <description>Craft accurate traditional bows edged for emergency close combat.</description>
    <baseCost>200</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Ferny_Arsenal</tab>
    <researchViewX>4.10</researchViewX>
    <researchViewY>0.60</researchViewY>
    <prerequisites>
      <li>RecurveBow</li>
      <li MayRequire="VexedTrees980.RimElvesBiotech">Ferny_CompositeBow</li>
    </prerequisites>
  </ResearchProjectDef>

  <ResearchProjectDef MayRequire="sarg.alphagenes">
    <defName>Ferny_ForsakenBattleAxe</defName>
    <label>forsaken battle axe</label>
    <description>Craft heavy alien war axes that hit hard but swing slowly.</description>
    <baseCost>250</baseCost>
