    <researchViewX>16</researchViewX><researchViewY>20</researchViewY>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <prerequisites><li>MultibarrelWeapons</li><li>HeavyTurrets</li></prerequisites>
  </ResearchProjectDef>
