  <Operation Class="PatchOperationFindMod"><mods><li>Rimpack Joyride</li></mods><match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="Rimride_Pack"]/recipeMaker/researchPrerequisite</xpath><value><researchPrerequisite>Ferny_TwinMinigunBackpack</researchPrerequisite></value></match></Operation>
