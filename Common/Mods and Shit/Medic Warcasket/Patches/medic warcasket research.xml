    <xpath>Defs/VFEPirates.WarcasketDef[defName="MDWC_Warcasket_Medic" or defName="MDWC_WarcasketHelmet_Medic" or defName="MDWC_WarcasketShoulders_Medic"]/researchPrerequisites</xpath>
