<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The graser cannon only exists with Biotech, and its project needs both DLCs -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>Odyssey</li></mods>
    <match Class="PatchOperationFindMod">
      <mods><li>Biotech</li></mods>
      <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="VFES_Complex_GraserCannon"]/researchPrerequisites</xpath><value><researchPrerequisites><li>Ferny_GraserCannonComplex</li></researchPrerequisites></value></match>
    </match>
  </Operation>
</Patch>
