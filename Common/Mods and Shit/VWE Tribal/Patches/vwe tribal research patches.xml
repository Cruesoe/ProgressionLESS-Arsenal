<?xml version="1.0" encoding="utf-8"?>
<Patch>
                <Operation Class="PatchOperationFindMod">
                    <mods>
                        <li>Vanilla Weapons Expanded - Tribal</li>
                    </mods>
                    <match Class="PatchOperationSequence">
                        <operations>
                            <li Class="PatchOperationReplace">
                                <xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_TribalAxe"]/label</xpath>
                                <value>
                                    <label>makeshift axe</label>
                                </value>
                            </li>
                            <li Class="PatchOperationReplace">
                                <xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_HeavyClub"]/recipeMaker/researchPrerequisite</xpath>
                                <value>
                                    <researchPrerequisite>Ferny_HeavyClub</researchPrerequisite>
                                </value>
                            </li>
                            <li Class="PatchOperationReplace">
                                <xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_LightClub"]/recipeMaker/researchPrerequisite</xpath>
                                <value>
                                    <researchPrerequisite>Ferny_Club</researchPrerequisite>
                                </value>
                            </li>
                            <li Class="PatchOperationReplace">
                                <xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_TribalAxe"]/recipeMaker/researchPrerequisite</xpath>
                                <value>
                                    <researchPrerequisite>Ferny_Club</researchPrerequisite>
                                </value>
                            </li>
                            <li Class="PatchOperationReplace">
                                <xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_Shiv"]/recipeMaker/researchPrerequisite</xpath>
                                <value>
                                    <researchPrerequisite>Ferny_Club</researchPrerequisite>
                                </value>
                            </li>
                            <li Class="PatchOperationReplace">
                                <xpath>Defs/ThingDef[defName="VWE_Sling"]/recipeMaker/researchPrerequisite</xpath>
                                <value>
                                    <researchPrerequisite>VFET_Bow</researchPrerequisite>
                                </value>
                            </li>
                            <!-- Combat Extended removes the shard and fire bomb recipeMakers and adds its own recipes -->
                            <li Class="PatchOperationConditional">
                                <xpath>Defs/ThingDef[defName="VWE_Throwing_Shards"]/recipeMaker/researchPrerequisite</xpath>
                                <match Class="PatchOperationReplace">
                                    <xpath>Defs/ThingDef[defName="VWE_Throwing_Shards"]/recipeMaker/researchPrerequisite</xpath>
                                    <value>
                                        <researchPrerequisite>VFET_Bow</researchPrerequisite>
                                    </value>
                                </match>
                            </li>
                            <li Class="PatchOperationConditional">
                                <xpath>Defs/ThingDef[defName="VWE_Weapon_FireBomb"]/recipeMaker/researchPrerequisite</xpath>
                                <match Class="PatchOperationReplace">
                                    <xpath>Defs/ThingDef[defName="VWE_Weapon_FireBomb"]/recipeMaker/researchPrerequisite</xpath>
                                    <value>
                                        <researchPrerequisite>Ferny_FireBombs</researchPrerequisite>
                                    </value>
                                </match>
                            </li>
                            <li Class="PatchOperationConditional">
                                <xpath>Defs/RecipeDef[defName="MakeVWEThrowingShard"]</xpath>
                                <match Class="PatchOperationAdd">
                                    <xpath>Defs/RecipeDef[defName="MakeVWEThrowingShard"]</xpath>
                                    <value>
                                        <researchPrerequisite>VFET_Bow</researchPrerequisite>
                                    </value>
                                </match>
                            </li>
                            <li Class="PatchOperationConditional">
                                <xpath>Defs/RecipeDef[defName="MakeFireBomb"]</xpath>
                                <match Class="PatchOperationAdd">
                                    <xpath>Defs/RecipeDef[defName="MakeFireBomb"]</xpath>
                                    <value>
                                        <researchPrerequisite>Ferny_FireBombs</researchPrerequisite>
                                    </value>
                                </match>
                            </li>
                        </operations>
                    </match>
                </Operation>
</Patch>
