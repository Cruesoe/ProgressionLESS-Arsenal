<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Molotovs: molotov cocktails replace GAE basic explosives -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>
          Defs/RecipeDef[defName="MakeMolotovCocktail"]/researchPrerequisite[text()="SEX_Plosives"]
          | Defs/RecipeDef[defName="MakeMolotovCocktail"]/researchPrerequisites/li[text()="SEX_Plosives"]
        </xpath>
        <match Class="PatchOperationRemove">
          <xpath>
            Defs/RecipeDef[defName="MakeMolotovCocktail"]/researchPrerequisite[text()="SEX_Plosives"]
            | Defs/RecipeDef[defName="MakeMolotovCocktail"]/researchPrerequisites/li[text()="SEX_Plosives"]
          </xpath>
        </match>
      </li>

      <li Class="PatchOperationConditional">
        <xpath>
          Defs/RecipeDef[defName="MakeMolotovCocktail"][
            not(researchPrerequisite="Ferny_MolotovCocktails")
            and not(researchPrerequisites/li="Ferny_MolotovCocktails")
          ]
        </xpath>
        <match Class="PatchOperationConditional">
          <xpath>Defs/RecipeDef[defName="MakeMolotovCocktail"]/researchPrerequisites</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/RecipeDef[defName="MakeMolotovCocktail"]/researchPrerequisites</xpath>
            <value>
              <li>Ferny_MolotovCocktails</li>
            </value>
          </match>

          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/RecipeDef[defName="MakeMolotovCocktail"]</xpath>
            <value>
              <researchPrerequisites>
                <li>Ferny_MolotovCocktails</li>
              </researchPrerequisites>
            </value>
          </nomatch>
        </match>
      </li>
    </operations>
  </Operation>

