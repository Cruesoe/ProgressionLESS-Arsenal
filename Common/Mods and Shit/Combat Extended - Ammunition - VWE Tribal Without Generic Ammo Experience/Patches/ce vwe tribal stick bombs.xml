<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="Ferny_FireBombs"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>
        Defs/RecipeDef[defName="MakeStickBomb"][
          not(researchPrerequisite="Ferny_FireBombs")
          and not(researchPrerequisites/li="Ferny_FireBombs")
        ]
      </xpath>
      <match Class="PatchOperationConditional">
        <xpath>Defs/RecipeDef[defName="MakeStickBomb"]/researchPrerequisites</xpath>
        <match Class="PatchOperationAdd">
          <xpath>Defs/RecipeDef[defName="MakeStickBomb"]/researchPrerequisites</xpath>
          <value>
            <li>Ferny_FireBombs</li>
          </value>
        </match>

        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/RecipeDef[defName="MakeStickBomb"]</xpath>
          <value>
            <researchPrerequisites>
              <li>Ferny_FireBombs</li>
            </researchPrerequisites>
          </value>
        </nomatch>
      </match>
    </match>
  </Operation>
</Patch>
