<?xml version="1.0" encoding="utf-8"?>          
<Patch>       
          <Operation Class="PatchOperationFindMod">
            <mods>
              <li>Medieval Overhaul</li>
            </mods>
            <match Class="PatchOperationSequence">
              <operations>
                  <li Class="PatchOperationAdd">
                        <xpath>/Defs</xpath>
                        <value>
                        <ReplaceLib.ReplacerDef>
                            <defName>Ferny_MedievalOverhaul_VFEMedieval2_Palisades</defName>
                            <replacers>
                                <li>
                                    <replace>DankPyon_Palisade</replace>
                                    <with>VFEM2_Palisade</with>
                                </li>
                            </replacers>
                        </ReplaceLib.ReplacerDef>
                        </value>
                  </li>
                  <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="VFEM2_Palisade"]/stuffCategories</xpath>
                    <value>
                        <stuffCategories>
                        			<li>DankPyon_RawWood</li>
                        </stuffCategories>
                    </value>
                  </li>
                  <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="VFEM2_Palisade"]/costStuffCount</xpath>
                    <value>
                        <costStuffCount>8</costStuffCount>
                    </value>
                  </li>
              </operations>
            </match>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_HeavyMace"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_HeavyMace</researchPrerequisite>
            </value>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_Flail"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_HeavyMace</researchPrerequisite>
            </value>
          </Operation>
          <!-- Throwing axe: Hatchets, or Axes when Hatchets is absent; Combat Extended replaces its recipeMaker with its own recipe -->
          <Operation Class="PatchOperationConditional">
            <xpath>Defs/ThingDef[defName="VFEM2_ThrowingAxe"]/recipeMaker/researchPrerequisite</xpath>
            <match Class="PatchOperationConditional">
              <xpath>Defs/ResearchProjectDef[defName="Ferny_Hatchet"]</xpath>
              <match Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="VFEM2_ThrowingAxe"]/recipeMaker/researchPrerequisite</xpath>
                <value>
                  <researchPrerequisite>Ferny_Hatchet</researchPrerequisite>
                </value>
              </match>
              <nomatch Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="VFEM2_ThrowingAxe"]/recipeMaker/researchPrerequisite</xpath>
                <value>
                  <researchPrerequisite>Ferny_Axe</researchPrerequisite>
                </value>
              </nomatch>
            </match>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_Warbow"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_Longbow</researchPrerequisite>
            </value>
          </Operation>
          <!-- Generic Ammo Experience removes matchlocks and moves its items to CE's Gunpowder -->
          <Operation Class="PatchOperationConditional">
            <xpath>Defs/ResearchProjectDef[defName="VFEM2_Matchlocks"]</xpath>
            <match Class="PatchOperationSequence">
              <operations>
                <li Class="PatchOperationReplace">
                  <xpath>Defs/ResearchProjectDef[defName="VFEM2_Matchlocks"]/label</xpath>
                  <value>
                    <label>hand cannon</label>
                  </value>
                </li>
                <li Class="PatchOperationReplace">
                  <xpath>Defs/ResearchProjectDef[defName="VFEM2_Matchlocks"]/description</xpath>
                  <value>
                    <description>Craft crude handheld gunpowder tubes that launch devastating shot at short range.</description>
                  </value>
                </li>
                <li Class="PatchOperationReplace">
                  <xpath>Defs/ResearchProjectDef[defName="VFEM2_Matchlocks"]/baseCost</xpath>
                  <value>
                    <baseCost>500</baseCost>
                  </value>
                </li>
                <li Class="PatchOperationReplace">
                  <xpath>Defs/ResearchProjectDef[defName="VFEM2_Matchlocks"]/generalRules</xpath>
                  <value>
                    <generalRules>
                      <rulesStrings>
                        <li>subject-&gt;hand cannons</li>
                        <li>subject_story-&gt;made crude handheld gunpowder weapons reliable enough for the field</li>
                        <li>subject_story-&gt;brought thunderous short-range firearms into battle</li>
                        <li>subject_story-&gt;learned to cast and brace early portable gun barrels</li>
                        <li>subject_gerund-&gt;crafting hand cannons</li>
                      </rulesStrings>
                    </generalRules>
                  </value>
                </li>
                <li Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="VFEM2_Gun_HandCannon"]/recipeMaker/researchPrerequisite</xpath>
                  <value>
                    <researchPrerequisite>VFEM2_Matchlocks</researchPrerequisite>
                  </value>
                </li>
              </operations>
            </match>
          </Operation>
          <!-- The Generic Ammo Experience removes the arquebus when Black powder extras for Combat Extended is active -->
          <Operation Class="PatchOperationConditional">
            <xpath>Defs/ThingDef[defName="VFEM2_Gun_Arquebus"]/recipeMaker/researchPrerequisite</xpath>
            <match Class="PatchOperationReplace">
              <xpath>Defs/ThingDef[defName="VFEM2_Gun_Arquebus"]/recipeMaker/researchPrerequisite</xpath>
              <value>
                <researchPrerequisite>Ferny_Arquebus</researchPrerequisite>
              </value>
            </match>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_Gun_Musket"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_Arquebus</researchPrerequisite>
            </value>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_Gun_Flintlock"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_Flintlock</researchPrerequisite>
            </value>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_Turret_WallMountedArquebus"]/researchPrerequisites</xpath>
            <value>
              <researchPrerequisites>
                <li>Ferny_Arquebus</li>
              </researchPrerequisites>
            </value>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_Claymore"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_MOLongsword</researchPrerequisite>
            </value>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_DaneAxe"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_DaneAxe</researchPrerequisite>
            </value>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_Halberd"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_Halberd</researchPrerequisite>
            </value>
          </Operation>
          <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_Pike"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite>Ferny_BattleAxe</researchPrerequisite>
            </value>
          </Operation>
</Patch>
