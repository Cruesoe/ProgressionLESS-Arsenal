<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Eventide and sovereign warcaskets: spacer warcaskets, plus the controller warcasket's microelectronics -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/VFEPirates.WarcasketDef[defName="dvd_Warcasket_Eventide" or defName="dvd_WarcasketShoulders_Eventide" or defName="dvd_WarcasketHelmet_Eventide" or defName="dvd_Warcasket_Sovereign"]/researchPrerequisites</xpath>
    <value>
      <researchPrerequisites Inherit="False">
        <li>VFEP_SpacerWarcaskets</li>
        <li>MicroelectronicsBasics</li>
      </researchPrerequisites>
    </value>
  </Operation>
</Patch>
